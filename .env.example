# ThinCMS MCP Server Configuration
#
# Base URL of your ThinCMS instance (no trailing slash)
THINCMS_BASE_URL=https://yoursite.com

# API key generated from ThinCMS admin (Admin > API Keys)
THINCMS_API_KEY=tcms_your_api_key_here

# Site ID from ThinCMS (visible in admin settings or API key creation)
THINCMS_SITE_ID=your_site_id_here
